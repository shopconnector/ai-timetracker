# TimeTracker Configuration
# Skopiuj ten plik do apps/web/.env.local i wypełnij wartościami

# =============================================================================
# ACTIVITYWATCH
# =============================================================================
# URL do ActivityWatch API (domyślnie localhost:5600)
ACTIVITYWATCH_URL=http://localhost:5600

# =============================================================================
# TEMPO API (wymagane)
# =============================================================================
# Token API z Tempo
# Utwórz: Tempo → Settings → API Integration → Create token
TEMPO_API_TOKEN=

# =============================================================================
# JIRA API (wymagane)
# =============================================================================
# Base URL Twojej instancji Jira
JIRA_BASE_URL=https://your-company.atlassian.net

# Email konta serwisowego lub Twój email
JIRA_SERVICE_EMAIL=your.email@company.com

# Token API do Jira
# Utwórz: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_KEY=

# =============================================================================
# GEMINI API (zalecane — darmowe)
# =============================================================================
# Klucz API do Google Gemini — darmowy tier
# Utwórz: https://aistudio.google.com/apikey
# Domyślny model: gemini-2.5-flash (szybki, darmowy)
GEMINI_API_KEY=

# Opcjonalnie: zmien model (gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# OPENROUTER (opcjonalne — fallback jesli brak Gemini)
# =============================================================================
# Token do OpenRouter jako zapasowy provider AI
# Utwórz: https://openrouter.ai/keys
OPENROUTER_API_KEY=
