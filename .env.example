# TimeTracker Configuration
# Skopiuj ten plik do apps/web/.env.local i wypełnij wartościami

# =============================================================================
# ACTIVITYWATCH
# =============================================================================
# URL do ActivityWatch API (domyślnie localhost:5600)
ACTIVITYWATCH_URL=http://localhost:5600

# =============================================================================
# TEMPO API (wymagane — chyba że używasz TEMPO_OAUTH poniżej)
# =============================================================================
# Personal token z Tempo. Alternatywa: TEMPO_OAUTH (preferowane).
# Utwórz: Tempo → Settings → API Integration → Create token
TEMPO_API_TOKEN=

# =============================================================================
# TEMPO OAuth 2.0 — alternatywa dla TEMPO_API_TOKEN
# =============================================================================
# Tempo to OSOBNY system OAuth od Atlassiana — osobna rejestracja aplikacji,
# osobny consent screen, osobne client_id/secret. Token endpoint: api.tempo.io
#
# Setup (jednorazowo, wymaga roli Tempo Admin + Jira Admin):
#   1. W Jirze: Apps → Tempo → Settings → Data Access → OAuth 2.0 Applications
#   2. New Application → Authorization Code Grant
#   3. Redirect URI: http://localhost:5666/timetracker/api/auth/tempo/callback
#   4. Scopes (matrix): Worklogs: Manage, Work attributes: View, Accounts: View
#   5. Skopiuj Client ID i Client Secret → wpisz w UI Settings → Tempo OAuth 2.0
TEMPO_OAUTH_CLIENT_ID=
TEMPO_OAUTH_CLIENT_SECRET=
TEMPO_OAUTH_SITE_URL=https://your-company.atlassian.net
TEMPO_OAUTH_REDIRECT_URI=http://localhost:5666/timetracker/api/auth/tempo/callback
# Poniższe ustawiane AUTOMATYCZNIE przez callback handler:
TEMPO_OAUTH_ACCESS_TOKEN=
TEMPO_OAUTH_REFRESH_TOKEN=
TEMPO_OAUTH_EXPIRES_AT=
TEMPO_OAUTH_SCOPES=

# =============================================================================
# JIRA API (wymagane)
# =============================================================================
# Base URL Twojej instancji Jira
JIRA_BASE_URL=https://your-company.atlassian.net

# Email konta serwisowego lub Twój email
JIRA_SERVICE_EMAIL=your.email@company.com

# Token API do Jira
# Utwórz: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_KEY=

# =============================================================================
# ATLASSIAN OAuth 2.0 (3LO) — alternatywa dla JIRA_API_KEY + Confluence R/W
# =============================================================================
# Jeśli skonfigurowane, OAuth ma priorytet nad Basic Auth (Jira) i odblokowuje
# Confluence (read + write). Można też mieć obie metody — appka preferuje OAuth.
#
# Setup (jednorazowo):
#   1. https://developer.atlassian.com/console/myapps/ → Create app → OAuth 2.0 integration
#   2. Permissions → Jira API + Confluence API → Configure → zaznacz scope'y:
#      offline_access, read:me, read:jira-work, write:jira-work,
#      read:confluence-space.summary, read:confluence-content.summary,
#      read:confluence-content.all, write:confluence-content, read:confluence-user
#   3. Authorization → Callback URL: http://localhost:5666/timetracker/api/auth/atlassian/callback
#   4. Skopiuj Client ID i Secret → wpisz w UI Settings → Jira API → OAuth 2.0
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_SITE_URL=https://your-company.atlassian.net
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:5666/timetracker/api/auth/atlassian/callback
# Poniższe ustawiane AUTOMATYCZNIE przez callback handler po pierwszym Connect:
ATLASSIAN_OAUTH_ACCESS_TOKEN=
ATLASSIAN_OAUTH_REFRESH_TOKEN=
ATLASSIAN_OAUTH_EXPIRES_AT=
ATLASSIAN_OAUTH_CLOUD_ID=
ATLASSIAN_OAUTH_USER_EMAIL=
ATLASSIAN_OAUTH_USER_NAME=
ATLASSIAN_OAUTH_SCOPES=

# =============================================================================
# GEMINI API (zalecane — darmowe)
# =============================================================================
# Klucz API do Google Gemini — darmowy tier
# Utwórz: https://aistudio.google.com/apikey
# Domyślny model: gemini-2.5-flash (szybki, darmowy)
GEMINI_API_KEY=

# Opcjonalnie: zmien model (gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# SLACK API (opcjonalne)
# =============================================================================
# User Token (xoxp-) — widzi DM, kanaly, huddle
# Utwórz: https://api.slack.com/apps → OAuth & Permissions
# Wymagane scopes: channels:history, channels:read, groups:history, groups:read,
#   im:history, im:read, mpim:history, mpim:read, users:read
SLACK_USER_TOKEN=

# =============================================================================
# OPENROUTER (opcjonalne — fallback jesli brak Gemini)
# =============================================================================
# Token do OpenRouter jako zapasowy provider AI
# Utwórz: https://openrouter.ai/keys
OPENROUTER_API_KEY=
